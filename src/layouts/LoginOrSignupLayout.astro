<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>
    <body>
        <div class="page-background">
            <div class="login-or-signup-layout">
                <div class="login-or-signup-cred-container">
                    <img src="/LKZlogo.webp" alt="Lakingz Services Logo" class="container-logo" />
                    <br />
                    <!-- the slot is supposed to be the login or signup component-->
                    <slot />
                    
                </div>
                <div class="vertical-divider"></div>
                <div class="login-or-signup-page-img-container">
                    <img src="/login_boilerplate_photo.webp" alt="Login or Signup Page Image" class="login-or-signup-page-img" />
                </div>
            </div>
        </div>
        <style>
            .page-background {
                
                display: flex;
                height: 100vh;
                width: 100vw;
                /* TODO create a variable for the background color of the page background*/
                /* apart from vertical divider all the background color should be the same as the login or signup layout background color*/
                background-color: oklch(98.8% 0.003 145);
                justify-content: center;
                align-items: center;
            }

            
            .login-or-signup-layout {
                display: flex;
                flex-direction: row;
                align-items: stretch;
                width: 800px;
                height: 350px;
                border-radius: 25px;
                border: 10px solid black;
                padding: 1px;
                
            }
            /* the credentials container is supposed to be to the left of the vertical divider and take more space*/
            .login-or-signup-cred-container {
                width: 55%;
                height: 100%;
                position: relative;
            }
        
            .container-logo {
                position: absolute;
                top: 10px;
                left: 10px;
                width: 10%;
                height: 10%;
            }
            /* the image container is supposed to be to the right of the credentials container and take less space*/
            .login-or-signup-page-img-container {
                width: 44%;
                height: 100%;
                
            }
            .vertical-divider {
                width: 1%;
                height: 100%;
                background-color: oklch(88% 0.08 145);        
            }
            
            /* the image is supposed to fill the container and be centered*/
            .login-or-signup-page-img {
                width: 100%;
                height: 100%;
            }
        </style>
    </body>
</html>