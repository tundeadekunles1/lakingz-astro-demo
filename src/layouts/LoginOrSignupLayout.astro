---
interface Props {
  title?: string;
  eyebrow?: string;
  heading?: string;
  description?: string;
}

const {
  title = 'Login or Sign Up | Lakingz Services',
  eyebrow = 'Secure Client Portal',
  heading = 'Welcome to your Lakingz account.',
  description = 'Access your secure workspace for tax documents, onboarding, and advisory updates.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/lkzfavicon.png" />
  </head>
  <body>
    <main class="auth-page">
      <section class="auth-shell" aria-label="Lakingz account access">
        <div class="auth-panel">
          <a href="/" class="brand-link" aria-label="Back to Lakingz Services home">
            <img src="/LKZlogo.webp" alt="Lakingz Services Logo" class="brand-logo" />
            <span class="brand-copy">Lakingz <strong>Services</strong></span>
          </a>

          <div class="auth-copy">
            <span class="auth-eyebrow">{eyebrow}</span>
            <h1>{heading}</h1>
            <p>{description}</p>
          </div>

          <div class="auth-card">
            <slot />
          </div>
        </div>

        <aside class="auth-visual" aria-label="Lakingz advisory preview">
          <img
            src="/login_boilerplate_photo.webp"
            alt="A Lakingz Services advisor preparing financial documents"
            class="auth-image"
          />
          <div class="visual-overlay">
            <span class="overlay-kicker">CPA-led guidance</span>
            <p>Keep filings, documents, and next steps organized in one calm workspace.</p>
          </div>
        </aside>
      </section>
    </main>

    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&family=Prata&display=swap');

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        /* TODO create a variable for the background color of the page background*/
        /* TODO use a css file to define all css variables*/
        font-family: 'Lexend', system-ui, sans-serif;
        color: oklch(20% 0.018 160);
        background:
          radial-gradient(circle at top left, oklch(88% 0.08 145 / 45%), transparent 32rem),
          radial-gradient(circle at bottom right, oklch(80% 0.07 240 / 30%), transparent 30rem),
          oklch(98.8% 0.003 145);
      }

      button,
      input {
        font: inherit;
      }
    </style>

    <style>
      .auth-page {
        min-height: 100vh;
        width: 100%;
        display: grid;
        place-items: center;
        padding: clamp(1rem, 4vw, 3rem);
      }

      .auth-shell {
        width: min(1080px, 100%);
        min-height: min(700px, calc(100vh - 2rem));
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(340px, 0.8fr);
        overflow: hidden;
        border: 1px solid oklch(90% 0.006 150);
        border-radius: 32px;
        background: oklch(99.4% 0.002 145 / 88%);
        box-shadow: 0 24px 80px oklch(0% 0 0 / 9%);
        backdrop-filter: blur(18px);
      }

      .auth-panel {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: clamp(1.5rem, 3vw, 2.4rem);
        padding: clamp(1.5rem, 5vw, 4rem);
      }

      .brand-link {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        color: inherit;
        text-decoration: none;
      }

      .brand-logo {
        width: 46px;
        height: 46px;
        object-fit: contain;
        border-radius: 14px;
        background: white;
        box-shadow: 0 10px 28px oklch(0% 0 0 / 7%);
      }

      .brand-copy {
        font-size: 0.95rem;
        letter-spacing: -0.01em;
      }

      .brand-copy strong {
        color: oklch(55% 0.12 145);
      }

      .auth-copy {
        max-width: 520px;
      }

      .auth-eyebrow {
        display: inline-flex;
        margin-bottom: 0.85rem;
        color: oklch(55% 0.12 145);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .auth-copy h1 {
        margin: 0;
        font-family: 'Prata', Georgia, serif;
        font-size: clamp(2.15rem, 4vw, 4rem);
        line-height: 1.05;
        letter-spacing: -0.04em;
      }

      .auth-copy p {
        max-width: 42rem;
        margin: 1rem 0 0;
        color: oklch(42% 0.012 160);
        font-size: clamp(0.98rem, 1.5vw, 1.1rem);
        line-height: 1.7;
      }

      .auth-card {
        width: min(430px, 100%);
        padding: clamp(1rem, 2vw, 1.4rem);
        border: 1px solid oklch(90% 0.006 150);
        border-radius: 24px;
        /* TODO create a variable for the background color of the card*/
        /* TODO use a css file to define all css variables*/
        background: oklch(100% 0 0 / 76%);
        box-shadow: 0 14px 40px oklch(0% 0 0 / 5%);
      }

      .auth-visual {
        position: relative;
        min-height: 100%;
        isolation: isolate;
        overflow: hidden;
        background: oklch(20% 0.018 160);
      }

      .auth-visual::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        background:
          linear-gradient(180deg, oklch(14% 0.012 160 / 10%), oklch(14% 0.012 160 / 78%)),
          radial-gradient(circle at 25% 20%, oklch(88% 0.08 145 / 36%), transparent 20rem);
      }

      .auth-image {
        width: 100%;
        height: 100%;
        min-height: 700px;
        object-fit: cover;
        display: block;
        transform: scale(1.02);
      }

      .visual-overlay {
        position: absolute;
        left: clamp(1.25rem, 3vw, 2rem);
        right: clamp(1.25rem, 3vw, 2rem);
        bottom: clamp(1.25rem, 3vw, 2rem);
        z-index: 2;
        padding: 1.25rem;
        border: 1px solid oklch(100% 0 0 / 25%);
        border-radius: 22px;
        color: white;
        background: oklch(14% 0.012 160 / 48%);
        backdrop-filter: blur(16px);
      }

      .overlay-kicker {
        color: oklch(88% 0.08 145);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .visual-overlay p {
        margin: 0.65rem 0 0;
        font-size: clamp(1rem, 1.6vw, 1.25rem);
        line-height: 1.55;
      }

      :global(.login-container) {
        width: 100%;
        height: auto;
        background: transparent;
        text-align: left;
      }

      :global(.login-container-title) {
        display: block;
        margin-bottom: 1rem;
        font-family: 'Prata', Georgia, serif;
        font-size: clamp(1.55rem, 3vw, 2rem);
        font-weight: 400;
        letter-spacing: -0.03em;
      }

      :global(.space-below-txt),
      :global(.space-above-buttons) {
        display: none;
      }

      :global(.login-cred-and-button-container) {
        align-items: stretch;
        gap: 1rem;
      }

      :global(.login-cred-input-container) {
        gap: 0.85rem;
      }

      :global(.cred-input-box) {
        width: 100%;
        height: auto;
        min-height: 52px;
        display: flex;
        align-items: center;
        border: 1px solid oklch(88% 0.006 150);
        border-radius: 16px;
        background: white;
        padding: 0 1rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      :global(.cred-input-box:focus-within) {
        border-color: oklch(55% 0.12 145);
        box-shadow: 0 0 0 4px oklch(88% 0.08 145 / 35%);
      }

      :global(.cred-input-box-input) {
        color: oklch(20% 0.018 160);
        background: transparent;
      }

      :global(.cred-input-box-input::placeholder) {
        color: oklch(55% 0.012 160);
        text-transform: capitalize;
      }

      :global(.login-button-container) {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
      }

      :global(.space-between-buttons) {
        display: none;
      }

      :global(.cred-submit-or-switch-button) {
        width: 100%;
        height: 50px;
        border: 1px solid oklch(55% 0.12 145);
        border-radius: 999px;
        color: white;
        background: oklch(55% 0.12 145);
        cursor: pointer;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
      }

      :global(.cred-submit-or-switch-button:hover) {
        transform: translateY(-1px);
        box-shadow: 0 12px 28px oklch(55% 0.12 145 / 24%);
      }

      :global(.login-button-container .cred-submit-or-switch-button:last-child) {
        color: oklch(20% 0.018 160);
        background: white;
        border-color: oklch(88% 0.006 150);
      }

      @media (max-width: 860px) {
        .auth-shell {
          grid-template-columns: 1fr;
        }

        .auth-visual {
          min-height: 260px;
          order: -1;
        }

        .auth-image {
          min-height: 260px;
        }

        .auth-card {
          width: 100%;
        }
      }

      @media (max-width: 520px) {
        .auth-page {
          padding: 0;
        }

        .auth-shell {
          min-height: 100vh;
          border: 0;
          border-radius: 0;
        }

        .auth-panel {
          padding: 1.25rem;
        }
      }
    </style>
  </body>
</html>