---
import '../styles/index.css';
import '../styles/portal.css';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminMobileNav from '../components/admin/AdminMobileNav.astro';
import AdminTopbar from '../components/admin/AdminTopbar.astro';

interface Props {
  title?: string;
  description?: string;
  pageTitle?: string;
  pageDescription?: string;
}

const {
  title = 'Admin Console — Lakingz Services',
  description = 'Prototype admin console for Lakingz Services.',
  pageTitle,
  pageDescription,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/lkzfavicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <AdminSidebar currentPath={currentPath} />
      <div class="admin-content">
        <AdminMobileNav currentPath={currentPath} />
        <AdminTopbar currentPath={currentPath} />
        <main class="admin-main">
          {pageTitle && (
            <header class="admin-page-title">
              <h1>{pageTitle}</h1>
              {pageDescription && <p>{pageDescription}</p>}
            </header>
          )}
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
