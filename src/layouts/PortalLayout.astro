---
import '../styles/index.css';
import '../styles/portal.css';
import PortalSidebar from '../components/portal/PortalSidebar.astro';
import PortalMobileNav from '../components/portal/PortalMobileNav.astro';
import PortalTopbar from '../components/portal/PortalTopbar.astro';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'dashboard' | 'appointments' | 'invoices';
}

const {
  title = 'Client Portal — Lakingz Services',
  description = 'Prototype client portal for Lakingz Services.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/lkzfavicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="portal-body">
    <div class="portal-shell">
      <PortalSidebar currentPath={currentPath} />
      <div class="portal-content">
        <PortalMobileNav currentPath={currentPath} />
        <PortalTopbar currentPath={currentPath} />
        <main class="portal-main">
          <div class="portal-main-inner">
            <slot />
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
