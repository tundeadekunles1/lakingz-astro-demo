---
import type { InvoiceStatus } from '../../data/portal/invoices';

interface Props {
  status: InvoiceStatus;
}

const { status } = Astro.props;

const config: Record<InvoiceStatus, { label: string; cls: string }> = {
  PAID:    { label: 'Paid',    cls: 'badge--paid' },
  SENT:    { label: 'Sent',    cls: 'badge--sent' },
  OVERDUE: { label: 'Overdue', cls: 'badge--overdue' },
  DRAFT:   { label: 'Draft',   cls: 'badge--draft' },
};

const { label, cls } = config[status];
---

<span class:list={['badge', cls]}>{label}</span>

<style>
  .badge {
    display: inline-block;
    padding: 0.3em 0.85em;
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  /* Mint green — settled */
  .badge--paid {
    background-color: var(--color-mint);
    color: oklch(22% 0.02 145);
  }

  /* Deep charcoal — sent, awaiting payment */
  .badge--sent {
    background-color: var(--bg-footer);
    color: var(--text-inverse);
  }

  /* Warm red — past due */
  .badge--overdue {
    background-color: oklch(85% 0.08 25);
    color: oklch(28% 0.06 25);
  }

  /* Neutral grey — not yet billed */
  .badge--draft {
    background-color: oklch(92% 0.004 150);
    color: var(--text-muted);
  }
</style>
