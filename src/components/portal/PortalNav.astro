---
import { client } from '../../data/portal/invoices';
---

<header class="portal-nav">
  <div class="portal-container portal-nav-inner">
    <a href="/" class="portal-brand" aria-label="Lakingz Services Home">
      <img src="/LKZlogo.webp" alt="Lakingz Services" class="portal-logo" />
      <div class="portal-brand-text">
        <span class="portal-brand-name">Lakingz</span>
        <span class="portal-brand-sub">Client Portal</span>
      </div>
    </a>

    <nav class="portal-tabs" aria-label="Portal sections">
      <span class="portal-tab is-muted" aria-disabled="true">Dashboard</span>
      <span class="portal-tab is-muted" aria-disabled="true">Meetings</span>
      <span class="portal-tab is-active" aria-current="page">Invoices</span>
    </nav>

    <div class="portal-account">
      <div class="portal-avatar" aria-hidden="true">{client.initials}</div>
      <div class="portal-account-meta">
        <span class="portal-account-name">{client.name}</span>
        <span class="portal-account-role">{client.role}</span>
      </div>
      <a href="/" class="portal-signout">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <polyline points="16 17 21 12 16 7" />
          <line x1="21" y1="12" x2="9" y2="12" />
        </svg>
        <span>Sign out</span>
      </a>
    </div>
  </div>
</header>

<style>
  .portal-nav {
    background-color: var(--bg-surface);
    border-bottom: var(--sheet-border);
    border-top: 3px solid var(--accent-mint);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .portal-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 72px;
  }

  /* Brand wordmark */
  .portal-brand {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    line-height: 1;
  }

  .portal-logo {
    height: 42px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
  }

  .portal-brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .portal-brand-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  .portal-brand-sub {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-muted);
  }

  /* Center tabs */
  .portal-tabs {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .portal-tab {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    padding: 0.5em 1.1em;
    border-radius: 9999px;
    border: 1px solid transparent;
    line-height: 1;
  }

  .portal-tab.is-muted {
    color: var(--text-muted);
    cursor: default;
  }

  .portal-tab.is-active {
    color: var(--accent-mint);
    border-color: var(--accent-mint);
    background-color: oklch(88% 0.08 145 / 12%);
  }

  /* Account cluster */
  .portal-account {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .portal-avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: oklch(80% 0.07 240 / 22%);
    color: var(--accent-blue);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .portal-account-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .portal-account-name {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-main);
    white-space: nowrap;
  }

  .portal-account-role {
    font-size: 0.62rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-muted);
  }

  .portal-signout {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-left: var(--space-sm);
    padding-left: var(--space-sm);
    border-left: var(--sheet-border);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .portal-signout:hover {
    color: var(--text-main);
  }

  @media (max-width: 860px) {
    .portal-nav-inner {
      height: auto;
      flex-wrap: wrap;
      padding-top: var(--space-sm);
      padding-bottom: var(--space-sm);
      gap: var(--space-sm);
    }

    .portal-tabs {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 2px;
    }

    .portal-account-meta {
      display: none;
    }

    .portal-signout {
      margin-left: var(--space-xs);
      padding-left: var(--space-xs);
    }
  }
</style>
