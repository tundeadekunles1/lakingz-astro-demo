---
const services = [
  {
    num: "01",
    title: "Bookkeeping & Financial Reporting",
    short: "Organized, compliant records designed to keep your business running smoothly.",
    detail: "We set up automated, cloud-based ledgers that sync directly with your banking. We don't just dump numbers into a spreadsheet—we translate them into clean, executive-ready financial reports that help you secure loans, attract investors, and file taxes effortlessly.",
    newcomerFocus: "Perfect for new immigrant founders establishing their first Canadian corporate records without existing internal bookkeeping teams."
  },
  {
    num: "02",
    title: "Personal Tax Preparation",
    short: "Accurate, maximized returns that capture every newcomer credit and deduction.",
    detail: "Filing your first Canadian tax return can be intimidating. We carefully analyze your residency status, foreign income, moving expenses, tuition carry-overs, and child benefit eligibility to ensure you receive the full benefits you are legally entitled to.",
    newcomerFocus: "Specially audited for tax-filers navigating their first year in Canada, protecting you from common filing errors that trigger CRA delays."
  },
  {
    num: "03",
    title: "Corporate Tax Preparation",
    short: "Strategic tax planning for corporations looking to legally minimize liabilities.",
    detail: "We prepare and file T2 corporate returns with meticulous attention to detail. Our tax specialists identify legal ways to reduce tax burdens, optimize shareholder salary-vs-dividend structures, and ensure maximum deductions for eligible business expenses.",
    newcomerFocus: "Designed for immigrant-led corporations navigating Ontario and federal tax integrations for the first time."
  },
  {
    num: "04",
    title: "GST, HST & PST Filing",
    short: "Seamless compliance and calculation of consumer sales taxes in Ontario.",
    detail: "Avoid costly audit errors. We handle the complete calculation, reconciliation, and filing of your GST/HST returns. We also advise on whether the CRA's 'Quick Method of Accounting' can save your small business thousands in sales tax payments.",
    newcomerFocus: "Protects growing businesses from failing to register once crossing the $30,000 threshold, avoiding retroactive penalties."
  },
  {
    num: "05",
    title: "Payroll Management",
    short: "Reliable payroll systems that keep your team paid and CRA deductions compliant.",
    detail: "We set up and manage secure payroll platforms, calculate CPP/EI deductions, handle employee onboarding, process direct deposits, and generate year-end T4 and T4A slips. We make compliance simple so you can focus on leading your team.",
    newcomerFocus: "Provides clear guidance on navigating Canadian source deductions and avoiding severe CRA payroll penalties."
  },
  {
    num: "06",
    title: "Business Incorporation",
    short: "Launch your Ontario or Federal corporation with solid structural foundations.",
    detail: "We guide you through the entire incorporation process. From securing custom corporate name approvals to obtaining your CRA Business Number, GST/HST accounts, and designing a clear share-structure—we build the legal foundation for your dreams.",
    newcomerFocus: "Includes step-by-step assistance in opening corporate bank accounts and navigating corporate registration without Canadian credit history."
  },
  {
    num: "07",
    title: "Financial Consulting & Budgeting",
    short: "Long-term advisory and financial blueprints for sustainable wealth creation.",
    detail: "We serve as your fractional CFO. Together, we analyze cash flow, construct resilient operating budgets, model growth projections, and design financial roadmaps that protect your capital while positioning your business for scale.",
    newcomerFocus: "Bridges the gap between foreign business models and Canadian banking, credit systems, and capital markets."
  },
  {
    num: "08",
    title: "Audit Preparation Support",
    short: "High-trust defense and comprehensive documentation for CRA reviews.",
    detail: "Receiving a letter from the CRA is stressful. We step in to review the audit scope, organize your files to meet strict CRA standards, draft professional letters, and act as your authorized representative to resolve inquiries with zero stress.",
    newcomerFocus: "Empathetic, expert representation that translates complex CRA requests and prevents costly assessment errors."
  }
];
---

<section class="services-section section-padding" id="services">
  <div class="container services-grid">
    
    <!-- Sticky Information Column -->
    <div class="services-intro">
      <span class="intro-kicker" data-reveal style="--reveal-index: 0">Expertise & Services</span>
      <h2 class="intro-title" data-reveal style="--reveal-index: 1">Culturally aware, elite financial solutions.</h2>
      <p class="intro-desc" data-reveal style="--reveal-index: 2">
        Unlike high-volume seasonal tax chains or rigid, impersonal software, Lakingz Services combines elite corporate standards with personalized, empathetic support.
      </p>
      
      <!-- Visual Accent: Intersecting Brand Layer -->
      <div class="intro-art-box" aria-hidden="true" data-reveal="scale" style="--reveal-index: 3">
        <div class="art-layer art-layer-mint"></div>
        <div class="art-layer art-layer-teal"></div>
        <div class="art-layer-glow"></div>
        <div class="art-content">
          <span class="accent-number">100%</span>
          <span class="accent-label">Ontario Compliant filings reviewed by certified professionals</span>
        </div>
      </div>
      
      <p class="intro-sub-desc" data-reveal style="--reveal-index: 4">
        Click any service on the right to expand newcomer-specific strategies and deep-dive technical insights.
      </p>
    </div>

    <!-- Interactive Asymmetric Panel List -->
    <div class="services-list" id="services-accordion">
      {services.map((svc, idx) => (
        <div class="service-card" data-service={svc.num} data-reveal style={`--reveal-index: ${idx % 4}`}>
          <button class="service-trigger" aria-expanded="false" aria-controls={`svc-panel-${svc.num}`}>
            <span class="service-num">{svc.num}</span>
            <div class="service-header-text">
              <h3 class="service-title">{svc.title}</h3>
              <p class="service-short">{svc.short}</p>
            </div>
            <span class="service-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </button>
          
          <div class="service-panel" id={`svc-panel-${svc.num}`} aria-hidden="true">
            <div class="panel-content">
              <p class="service-detail">{svc.detail}</p>
              
              <!-- Specially highlighted newcomer value proposition -->
              <div class="newcomer-tag-box">
                <div class="badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="badge-icon"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                  Newcomer & Immigrant Insight
                </div>
                <p class="tag-desc">{svc.newcomerFocus}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .services-section {
    background-color: oklch(99.4% 0.002 145); /* Soft, airy surface background */
    position: relative;
    border-top: var(--sheet-border);
    border-bottom: var(--sheet-border);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  /* Sticky Left Column */
  .services-intro {
    position: sticky;
    top: 110px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .intro-kicker {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-blue);
    margin-bottom: var(--space-xs);
  }

  .intro-title {
    font-size: var(--fs-2xl);
    line-height: 1.15;
    margin-bottom: var(--space-sm);
    letter-spacing: -0.02em;
  }

  .intro-desc {
    font-size: var(--fs-base);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .intro-sub-desc {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin-top: var(--space-md);
    font-style: italic;
  }

  /* Intro Graphic Box */
  .intro-art-box {
    width: 100%;
    max-width: 360px;
    height: 140px;
    position: relative;
    border-radius: 20px;
    overflow: visible;
    margin-bottom: var(--space-xs);
    display: flex;
    align-items: center;
    padding: var(--space-sm);
    cursor: pointer;
  }

  .art-layer {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    transition: transform 0.6s var(--ease-expo), opacity 0.6s var(--ease-expo);
  }

  .art-layer-mint {
    background: linear-gradient(135deg, var(--color-mint) 0%, oklch(90% 0.04 145) 100%);
    transform: rotate(-3deg) scale(1.05);
    z-index: 1;
    opacity: 0.85;
  }

  .art-layer-teal {
    background: linear-gradient(135deg, var(--color-teal) 0%, oklch(86% 0.05 195) 100%);
    transform: rotate(3deg) scale(0.98);
    z-index: 2;
    mix-blend-mode: multiply;
    opacity: 0.9;
  }

  .art-layer-glow {
    position: absolute;
    inset: -10px;
    background: radial-gradient(circle, var(--color-blue) 0%, transparent 60%);
    z-index: 3;
    opacity: 0.4;
    filter: blur(10px);
    transition: transform 0.6s var(--ease-expo), opacity 0.6s var(--ease-expo);
  }

  .art-content {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    transition: transform 0.6s var(--ease-expo);
  }

  /* Hover Expansion Effects */
  .intro-art-box:hover .art-layer-mint {
    transform: rotate(-12deg) translate(-22px, -6px) scale(1.1);
    opacity: 0.75;
  }

  .intro-art-box:hover .art-layer-teal {
    transform: rotate(14deg) translate(22px, 6px) scale(1.08);
    opacity: 0.8;
  }

  .intro-art-box:hover .art-layer-glow {
    transform: scale(1.3);
    opacity: 0.65;
  }

  .intro-art-box:hover .art-content {
    transform: scale(1.03);
  }

  .accent-number {
    font-family: var(--font-heading);
    font-size: var(--fs-2xl);
    color: var(--text-main);
    line-height: 1;
  }

  .accent-label {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-main);
    line-height: 1.3;
  }

  /* Right Accordion List */
  .services-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Service Card Panel */
  .service-card {
    background-color: var(--bg-surface);
    border: var(--sheet-border);
    border-radius: 20px;
    box-shadow: var(--shadow-subtle);
    overflow: hidden;
    transition: var(--transition-smooth);
  }

  .service-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px oklch(20% 0.02 160 / 3%);
    border-color: var(--color-teal);
  }

  .service-trigger {
    width: 100%;
    background: none;
    border: none;
    padding: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    text-align: left;
    cursor: pointer;
    position: relative;
  }

  .service-num {
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    color: var(--color-dark-teal);
    opacity: 0.55;
    transition: var(--transition-fast);
  }

  .service-card:hover .service-num {
    opacity: 1;
    color: var(--accent-blue);
  }

  .service-header-text {
    flex: 1;
  }

  .service-title {
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    color: var(--text-main);
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }

  .service-short {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    font-weight: 300;
  }

  .service-arrow {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: transform 0.4s var(--ease-expo);
  }

  .service-arrow svg {
    width: 100%;
    height: 100%;
  }

  /* Accordion Expand/Collapse Panel */
  .service-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition:
      grid-template-rows 0.4s var(--ease-expo),
      visibility 0.4s var(--ease-expo),
      opacity 0.2s var(--ease-expo);
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
  }

  /* Panel Content wrapper inside grid */
  .panel-content {
    min-height: 0;
    overflow: hidden;
    padding: 0 var(--space-md) var(--space-md) calc(var(--space-md) + 36px);
  }

  .service-detail {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  /* Highlight Newcomer box */
  .newcomer-tag-box {
    background-color: oklch(98.8% 0.003 145);
    border: 1px solid var(--color-mint);
    border-radius: 12px;
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .newcomer-tag-box .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--accent-mint);
    letter-spacing: 0.05em;
  }

  .badge-icon {
    width: 14px;
    height: 14px;
  }

  .newcomer-tag-box .tag-desc {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--text-main);
    line-height: 1.5;
    margin: 0;
  }

  /* Active states via JS toggle */
  .service-card.active {
    border-color: var(--color-blue);
  }

  .service-card.active .service-panel {
    grid-template-rows: 1fr;
    visibility: visible;
    opacity: 1;
  }

  .service-card.active .service-arrow {
    transform: rotate(180deg);
    color: var(--accent-blue);
  }

  /* Responsive styling */
  @media (max-width: 968px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .services-intro {
      position: relative;
      top: 0;
      margin-bottom: var(--space-md);
    }

    .intro-art-box {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .service-trigger {
      padding: var(--space-sm);
    }
    .panel-content {
      padding: 0 var(--space-sm) var(--space-sm) var(--space-sm);
    }
  }
</style>

<script>
  // Dynamic Accordion Interaction
  const servicesContainer = document.getElementById('services-accordion');

  if (servicesContainer) {
    const cards = servicesContainer.querySelectorAll('.service-card');
    
    cards.forEach((card) => {
      const trigger = card.querySelector('.service-trigger');
      const panel = card.querySelector('.service-panel');
      
      trigger?.addEventListener('click', () => {
        const isActive = card.classList.contains('active');
        
        // Collapse all cards first to behave like proper single-accordion
        cards.forEach((c) => {
          c.classList.remove('active');
          c.querySelector('.service-trigger')?.setAttribute('aria-expanded', 'false');
          c.querySelector('.service-panel')?.setAttribute('aria-hidden', 'true');
        });
        
        // Toggle selected card
        if (!isActive) {
          card.classList.add('active');
          trigger.setAttribute('aria-expanded', 'true');
          panel?.setAttribute('aria-hidden', 'false');
        }
      });
    });

    // Expand the first service card as default visual demo
    if (cards.length > 0) {
      cards[0].classList.add('active');
      cards[0].querySelector('.service-trigger')?.setAttribute('aria-expanded', 'true');
      cards[0].querySelector('.service-panel')?.setAttribute('aria-hidden', 'false');
    }
  }
</script>
