<!-- Floating bottom CTA bar — visible on mobile only.
     Auto-hides when the Contact section scrolls into view so it
     never overlaps the intake form. -->
<div class="mobile-cta-bar" id="mobile-cta" aria-hidden="true">
  <div class="mobile-cta-inner">
    <p class="mobile-cta-label">Ready to file with a CPA?</p>
    <a href="#contact" class="btn btn-primary mobile-cta-btn">Book Consultation</a>
  </div>
</div>

<style>
  .mobile-cta-bar {
    /* Hidden on desktop */
    display: none;
  }

  @media (max-width: 860px) {
    .mobile-cta-bar {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 90;
      padding: var(--space-xs) var(--space-md) calc(var(--space-xs) + env(safe-area-inset-bottom, 0px));
      background-color: oklch(98.8% 0.003 145 / 92%);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: var(--sheet-border);
      box-shadow: 0 -4px 24px oklch(0% 0 0 / 4%);

      /* Slide-up entry */
      transform: translateY(0);
      transition: transform 0.5s var(--ease-expo), opacity 0.5s var(--ease-expo);
      opacity: 1;
    }

    /* Hidden state — slides down out of view */
    .mobile-cta-bar.is-hidden {
      transform: translateY(110%);
      opacity: 0;
      pointer-events: none;
    }
  }

  .mobile-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    max-width: 540px;
    margin: 0 auto;
  }

  .mobile-cta-label {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-main);
    line-height: 1.3;
    /* override global p max-width */
    max-width: none;
  }

  .mobile-cta-btn {
    flex-shrink: 0;
    font-size: var(--fs-xs);
    padding: 0.75em 1.4em;
    white-space: nowrap;
  }
</style>

<script>
  const bar = document.getElementById('mobile-cta');
  const contactSection = document.getElementById('contact');

  if (bar && contactSection) {
    // Reveal the bar after a brief delay on page load so it doesn't
    // immediately compete with the hero for attention.
    bar.removeAttribute('aria-hidden');

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          bar.classList.add('is-hidden');
          bar.setAttribute('aria-hidden', 'true');
        } else {
          bar.classList.remove('is-hidden');
          bar.removeAttribute('aria-hidden');
        }
      },
      // Start hiding the bar a little before the contact section fully appears.
      { threshold: 0.08 }
    );

    observer.observe(contactSection);

    // Smooth scroll — close the nav drawer if open (mobile UX polish)
    bar.querySelector('a')?.addEventListener('click', () => {
      const navMenu = document.getElementById('nav-menu');
      const menuBtn = document.getElementById('menu-btn');
      if (navMenu && menuBtn) {
        navMenu.setAttribute('aria-hidden', 'true');
        menuBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
