---
interface CredInputBoxProps {
    type: string;
    placeholder: string;
}
const { type, placeholder } = Astro.props;
---

<div class="cred-input-box">
    <input type={type} class="cred-input-box-input" placeholder={placeholder} />
</div>
<style>
    .cred-input-box {
        /* width and height are adjustable*/
        width: 250px;
        height: 20px;
        background-color: white;
        border-radius: 10px;
        border: 1px solid black;
        padding: 10px;
    }
    .cred-input-box-input {
        width: 100%;
        height: 100%;
        border: none;
        outline: none;
    }
</style>