---
import CredInputBox from './CredInputBox.astro';
import CredSubmitOrSwitchButton from './CredSubmitOrSwitchButton.astro';
---

<div class="login-container">
    <span class="login-container-title">Welcome back!</span>
        <!-- the horizontal space divider was created to avoid using absolute positioning-->
        <!-- to create space below the title and above the text boxes container -->
    <div class="space-below-txt"></div>
    <div class="login-cred-and-button-container">
        
        <!-- container for the cred input boxes -->
        <div class="login-cred-input-container">
            <CredInputBox type="text" placeholder="username" class="login-page-username-input" />
            <CredInputBox type="password" placeholder="password" class="login-page-password-input" />
            
        </div>
        <!-- to create space below the text boxes container and above the button container -->
        <div class="space-above-buttons"></div>
        <div class="login-button-container">
        <!-- container for the login and signup buttons -->
            <CredSubmitOrSwitchButton buttonType="login" class="login-page-login-button" />
            <div class="space-between-buttons"></div>
            <CredSubmitOrSwitchButton buttonType="signup" class="login-page-signup-button" />
        </div>
    </div>
</div>
<style>

    .login-container {
       /* the width is supposed to be 55% the credentials container in the login or signup layout*/
       /* the height is supposed to be 85% of the credentials container in the login or signup layout*/
       /* TODO create a variable for the width and height of the credentials container in the login or signup layout*/
       /* TODO create a variable for the background color of the login container*/
        width: 440px;
        height: 298px;
        --login-background-color: oklch(98.8% 0.003 145);
        background-color: var(--login-background-color);
        text-align: center;
        
    }

    .login-cred-and-button-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .login-container-title {
        text-align: center;
        font-size: 24px;
        font-weight: bold;
    }
    .space-below-txt {

        width: 100%;
        /* the height is supposed to be a percentage of the login container*/
        height: 10px;
        /* TODO background color of this element should be same as the login container background color*/
        background-color: var(--login-background-color);
    }

    .space-above-buttons {
        width: 100%;
        /* the height is supposed to be a percentage of the login container*/
        height: 10px;
        /* TODO background color of this element should be same as the login container background color*/
        background-color: var(--login-background-color);
    }

    .login-cred-input-container {
        display: grid;
        align-items: center;
        grid-template-columns: 1fr;
        justify-content: center;
        gap: 9px;
    }
    .login-button-container {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-template-rows: 1fr;
        grid-template-areas:
            "login-button space-between-buttons signup-button";
        
        /* gap should be enought to make the buttong edges align with the 
        cred input boxes edges*/
           
    }
</style>