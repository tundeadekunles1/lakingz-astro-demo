---
---
<section class="hero-section" id="hero">

  <!-- Left: Copy -->
  <div class="hero-copy">
    <div class="hero-copy-inner">

      <span class="hero-label" data-reveal style="--reveal-index: 0">Ontario's CPA Firm for Newcomers</span>

      <h1 class="hero-title" data-reveal style="--reveal-index: 1">
        Financial<br />
        clarity for your<br />
        <em>Canadian journey.</em>
      </h1>

      <p class="hero-desc" data-reveal style="--reveal-index: 2">
        We bridge the gap for newcomers and immigrant-led businesses navigating Canada's complex tax and regulatory systems. Guided by elite CPA standards forged at <strong>Deloitte and KPMG</strong>.
      </p>

      <div class="hero-actions" data-reveal style="--reveal-index: 3">
        <a href="#contact" class="btn btn-primary">Book Consultation</a>
        <a href="#services" class="btn btn-ghost">Explore Expertise</a>
      </div>

      <div class="hero-trust" data-reveal style="--reveal-index: 4">
        <div class="trust-entry">
          <span class="entry-index">01</span>
          <div class="entry-body">
            <span class="entry-value">98.2%</span>
            <span class="entry-label">Client Retention</span>
          </div>
        </div>
        <div class="trust-entry">
          <span class="entry-index">02</span>
          <div class="entry-body">
            <span class="entry-value">6+</span>
            <span class="entry-label">Years in Practice</span>
          </div>
        </div>
        <div class="trust-entry">
          <span class="entry-index">03</span>
          <div class="entry-body">
            <span class="entry-value">CPA</span>
            <span class="entry-label">Deloitte &amp; KPMG Trained</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Right: Image -->
  <div class="hero-image-col" aria-hidden="true" data-reveal="scale" style="--reveal-index: 1">
    <img
      src="/kemi-001.webp"
      alt="Kemi Olobade, Lead CPA at Lakingz Services, consulting with a client"
      class="hero-photo"
      loading="eager"
      fetchpriority="high"
    />

  </div>

</section>

<style>
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100svh;
    padding-top: 80px; /* navbar height */
  }

  /* ── Left Column ─────────────────────────────── */
  .hero-copy {
    display: flex;
    align-items: center;
    padding: var(--space-lg) var(--space-xl);
    background-color: var(--bg-canvas);
  }

  .hero-copy-inner {
    max-width: 560px;
  }

  .hero-label {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-mint);
    margin-bottom: var(--space-sm);
  }

  .hero-title {
    font-size: clamp(2.8rem, 4vw + 1rem, 5.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: var(--space-md);
    font-weight: 400;
  }

  .hero-title em {
    font-style: italic;
    color: var(--accent-mint);
  }

  .hero-desc {
    font-size: var(--fs-base);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 48ch;
    margin-bottom: var(--space-lg);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-main);
    padding: 0.9em 1.6em;
    border-radius: 9999px;
    border: 1px solid oklch(80% 0.01 160);
    transition: var(--transition-smooth);
    cursor: pointer;
  }
  .btn-ghost:hover {
    border-color: var(--text-main);
    background-color: oklch(95% 0.004 160);
    transform: translateY(-2px);
  }

  /* Trust stats — indexed document style */
  .hero-trust {
    display: flex;
    gap: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid oklch(90% 0.006 150);
    flex-wrap: wrap;
  }

  .trust-entry {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .entry-index {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-mint);
    line-height: 1;
    padding-top: 2px;
    flex-shrink: 0;
  }

  .entry-body {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .entry-value {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--text-main);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .entry-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* ── Right Column (Image) ─────────────────────── */
  .hero-image-col {
    position: relative;
    overflow: hidden;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* Subtle left-edge gradient so image blends into copy panel */
  .hero-image-col::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--bg-canvas) 0%, transparent 12%);
    z-index: 1;
    pointer-events: none;
  }

  /* ── Responsive ───────────────────────────────── */
  @media (max-width: 968px) {
    .hero-section {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-copy {
      padding: calc(var(--space-xl) + 80px) var(--space-md) var(--space-lg);
    }

    .hero-copy-inner {
      max-width: 100%;
    }

    /* Portrait source (2:3) needs a tall frame on mobile so the people in
       the scene aren't cropped out. A short landscape box left only the wall
       above the subject visible. */
    .hero-image-col {
      height: auto;
      aspect-ratio: 4 / 5;
      min-height: 0;
      max-height: 78vh;
    }

    .hero-photo {
      /* Bias the crop down from the top so her face and the desk read,
         instead of the empty panelled wall. */
      object-position: center 28%;
    }

    .hero-image-col::before {
      background: linear-gradient(to bottom, var(--bg-canvas) 0%, transparent 15%);
    }

    .hero-trust {
      gap: var(--space-sm);
      flex-wrap: wrap;
    }
  }

  @media (max-width: 480px) {
    .hero-copy {
      padding-top: calc(var(--space-lg) + 80px);
    }

    .hero-title {
      font-size: clamp(2.2rem, 8vw, 3rem);
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn,
    .hero-actions .btn-ghost {
      width: 100%;
      justify-content: center;
    }

    .hero-trust {
      gap: var(--space-md);
    }
  }
</style>
