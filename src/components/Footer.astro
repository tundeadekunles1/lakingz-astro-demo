---
---
<footer class="footer-element">
  <div class="container footer-editorial-grid">
    
    <!-- Large Hook & Minimal Newsletter CTA -->
    <div class="footer-hero-block" data-reveal="left">
      <h3 class="footer-hero-title">
        Start your financial journey with CPA precision.
      </h3>
      <p class="footer-hero-desc">
        Receive curated tax strategies and regulatory updates for Ontario newcomers and small businesses directly in your inbox. No spam, ever.
      </p>
      
      <!-- Minimalist Newsletter Form (Fixed Layout) -->
      <div class="footer-newsletter-field">
        <form class="footer-newsletter-form" id="footer-newsletter-form" novalidate>
          <label for="footer-email" class="sr-only">Email Address</label>
          <input
            type="email"
            id="footer-email"
            name="email"
            placeholder="your.email@domain.ca"
            class="newsletter-input"
            autocomplete="email"
            inputmode="email"
            aria-required="true"
            aria-describedby="footer-email-error footer-newsletter-success"
            aria-invalid="false"
            required
          />
          <button type="submit" class="newsletter-submit-btn" aria-label="Subscribe to newsletter">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="newsletter-check" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="newsletter-btn-text">Subscribe</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="newsletter-arrow" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </form>
        <span class="newsletter-feedback newsletter-feedback--error" id="footer-email-error" role="alert" aria-live="polite">Please enter a valid email address.</span>
        <p class="newsletter-feedback newsletter-feedback--success" id="footer-newsletter-success" aria-live="polite" hidden>Thanks! Curated tax updates are on their way to your inbox.</p>
      </div>
    </div>

    <!-- Right Brand & Contacts Box -->
    <div class="footer-identity-block" data-reveal="right">
      <div class="logo-container">
        <img src="/LKZlogo.webp" alt="Lakingz Services Logo" class="logo-image" />
      </div>
      
      <p class="brand-pitch">
        Bespoke accounting & tax solutions. Culturally aware, CPA-governed excellence supporting Ontario's newcomers and growing businesses.
      </p>

      <div class="footer-contacts">
        <a href="mailto:info@lakingzservices.ca" class="contact-link">
          <span class="contact-label">Email</span>
          <span class="contact-value">info@lakingzservices.ca</span>
        </a>
        <a href="tel:+19055550199" class="contact-link">
          <span class="contact-label">Phone</span>
          <span class="contact-value">+1 (905) 555-0199</span>
        </a>
      </div>
    </div>

  </div>

  <!-- Middle Link Columns (Asymmetrical Grid) -->
  <div class="container footer-links-section">
    <div class="links-grid">
      
      <div class="links-col" data-reveal style="--reveal-index: 0">
        <h4 class="col-title">Practice Areas</h4>
        <ul class="col-links">
          <li><a href="#services" class="footer-nav-link">Corporate Tax Preparation (T2)</a></li>
          <li><a href="#services" class="footer-nav-link">Newcomer Personal Tax (T1)</a></li>
          <li><a href="#services" class="footer-nav-link">Full Bookkeeping & Financials</a></li>
          <li><a href="#services" class="footer-nav-link">Business Incorporation & Structuring</a></li>
        </ul>
      </div>

      <div class="links-col" data-reveal style="--reveal-index: 1">
        <h4 class="col-title">Navigation</h4>
        <ul class="col-links">
          <li><a href="#about" class="footer-nav-link">Our Story</a></li>
          <li><a href="#services" class="footer-nav-link">Core Expertise</a></li>
          <li><a href="#navigator" class="footer-nav-link">Interactive Tax Navigator</a></li>
          <li><a href="#contact" class="footer-nav-link">Book Consultation</a></li>
        </ul>
      </div>

      <div class="links-col compliance-col" data-reveal style="--reveal-index: 2">
        <h4 class="col-title">Ontario Compliance</h4>
        <p class="compliance-text">
          Operated in accordance with Canadian accounting guidelines and Chartered Professional Accountant standards. Supported by qualified CPA Canada practitioners.
        </p>
        <div class="location-print">
          <span class="loc-head">Brampton HQ</span>
          <span class="loc-addr">16 Langholm Court, Brampton, ON</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Giant Editorial Serif Watermark -->
  <div class="huge-watermark-container" aria-hidden="true">
    <span class="watermark-text">LAKINGZ</span>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-wrapper">
      <span class="copyright">© {new Date().getFullYear()} Lakingz Services. All rights reserved.</span>
      <span class="designer-tag">Bespoke CPA governance for Ontario’s newcomer & business community.</span>
    </div>
  </div>
</footer>

<style>
  /* Fully light mode background integrated with main canvas */
  .footer-element {
    background-color: var(--bg-canvas); /* Crisp warm-minty white background of the site */
    color: var(--text-muted);
    padding: var(--space-2xl) 0 0 0;
    border-top: var(--sheet-border); /* Thin light divider border */
    position: relative;
    overflow: hidden;
  }

  /* Asymmetric Top Grid */
  .footer-editorial-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid oklch(90% 0.006 145);
  }

  .footer-hero-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .footer-hero-title {
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    line-height: 1.25;
    color: var(--text-main);
    margin-bottom: var(--space-xs);
    max-width: 25ch;
  }

  .footer-hero-desc {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
    max-width: 48ch;
  }

  .footer-newsletter-field {
    width: 100%;
    max-width: 440px;
  }

  /* Fixed Newsletter CTA Input Styling */
  .footer-newsletter-form {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: none;
    background-color: var(--bg-surface);
    border: var(--sheet-border);
    border-radius: 14px;
    overflow: hidden;
    padding: 6px;
    gap: 8px;
    transition: var(--transition-fast);
  }

  .footer-newsletter-form:focus-within {
    border-color: var(--accent-teal);
    box-shadow: 0 0 12px oklch(50% 0.10 195 / 8%);
  }

  .footer-newsletter-form.is-invalid {
    border-color: oklch(72% 0.12 25);
    box-shadow: 0 0 12px oklch(60% 0.15 20 / 6%);
  }

  .footer-newsletter-form.is-success {
    border-color: var(--accent-mint);
    box-shadow: 0 0 14px oklch(55% 0.12 145 / 10%);
  }

  .newsletter-input.is-invalid {
    color: var(--text-main);
  }

  .newsletter-input {
    flex-grow: 1;
    min-width: 0;
    background: transparent;
    border: none;
    padding: 10px 14px;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--text-main);
  }

  .newsletter-input:focus {
    outline: none;
  }

  .newsletter-input::placeholder {
    color: var(--text-muted);
    opacity: 0.5;
  }

  .newsletter-input:disabled {
    opacity: 0.72;
    cursor: default;
  }

  .newsletter-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background-color: var(--text-main);
    color: var(--text-inverse);
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
    flex-shrink: 0;
    position: relative;
  }

  .newsletter-submit-btn:hover {
    background-color: var(--accent-teal);
    color: var(--text-inverse);
  }

  .newsletter-submit-btn:disabled {
    cursor: wait;
    opacity: 0.85;
  }

  .newsletter-submit-btn.is-loading .newsletter-arrow {
    opacity: 0;
    transform: translateX(6px);
  }

  .newsletter-submit-btn.is-success {
    background-color: var(--accent-mint);
    pointer-events: none;
  }

  .newsletter-submit-btn.is-success:hover {
    background-color: var(--accent-mint);
  }

  .newsletter-check {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    display: none;
  }

  .newsletter-submit-btn.is-success .newsletter-check {
    display: block;
  }

  .newsletter-submit-btn.is-success .newsletter-arrow {
    display: none;
  }

  .newsletter-feedback {
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 1.5;
    margin-top: 8px;
  }

  .newsletter-feedback--error {
    display: none;
    color: oklch(60% 0.15 20);
  }

  .footer-newsletter-field.is-invalid .newsletter-feedback--error {
    display: block;
  }

  .newsletter-feedback--success {
    color: var(--accent-mint);
    font-weight: 500;
    opacity: 0;
    transform: translateY(4px);
    transition: var(--transition-fast);
  }

  .newsletter-feedback--success.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .newsletter-feedback--success[hidden] {
    display: none;
  }

  .newsletter-feedback--success.is-visible[hidden] {
    display: block;
  }

  .newsletter-arrow {
    width: 14px;
    height: 14px;
    transition: transform 0.3s var(--ease-expo);
  }

  .newsletter-submit-btn:hover .newsletter-arrow {
    transform: translateX(3px);
  }

  /* Identity Block */
  .footer-identity-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .logo-container {
    display: flex;
    align-items: center;
  }

  .logo-image {
    height: 44px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .brand-pitch {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-contacts {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .contact-value {
    font-size: var(--fs-xs);
    color: var(--text-main);
    font-weight: 500;
    transition: var(--transition-fast);
  }

  .contact-link:hover .contact-value {
    color: var(--accent-teal);
  }

  /* Asymmetric link blocks */
  .footer-links-section {
    padding: var(--space-lg) 0;
  }

  .links-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1.2fr;
    gap: var(--space-lg);
  }

  .col-title {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    color: var(--text-main);
    margin-bottom: var(--space-sm);
    font-weight: 400;
  }

  .col-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-nav-link {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    transition: var(--transition-fast);
    display: inline-block;
  }

  .footer-nav-link:hover {
    color: var(--text-main);
    transform: translateX(3px);
  }

  /* Compliance & Address Layout (No box, clean editorial flow) */
  .compliance-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .compliance-text {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .location-print {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: var(--sheet-border);
    padding-top: var(--space-xs);
  }

  .loc-head {
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-mint);
  }

  .loc-addr {
    font-size: 11px;
    color: var(--text-main);
    font-weight: 500;
  }

  /* Giant backdrop watermark */
  .huge-watermark-container {
    user-select: none;
    pointer-events: none;
    text-align: center;
    padding-top: var(--space-md);
    margin-bottom: -15px;
  }

  .watermark-text {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 15.5vw, 11rem);
    font-weight: 400;
    color: oklch(20% 0.018 160 / 6%);
    letter-spacing: 0.28em;
    line-height: 0.9;
    display: inline-block;
  }

  /* Bottom Bar */
  .footer-bottom {
    border-top: var(--sheet-border);
    padding: var(--space-md) 0;
    position: relative;
    z-index: 2;
  }

  .bottom-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .copyright, .designer-tag {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--text-muted);
    opacity: 0.8;
  }

  /* Responsive styles */
  @media (max-width: 968px) {
    .footer-editorial-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    
    .links-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
    }

    .compliance-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 580px) {
    .links-grid {
      grid-template-columns: 1fr;
    }

    .compliance-col {
      grid-column: span 1;
    }

    .bottom-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>

<script>
  const newsletterForm = document.getElementById('footer-newsletter-form') as HTMLFormElement | null;
  const newsletterField = document.querySelector('.footer-newsletter-field');
  const emailInput = document.getElementById('footer-email') as HTMLInputElement | null;
  const submitBtn = newsletterForm?.querySelector('.newsletter-submit-btn') as HTMLButtonElement | null;
  const btnText = submitBtn?.querySelector('.newsletter-btn-text');
  const successMsg = document.getElementById('footer-newsletter-success');

  const successBtnLabel = "You're subscribed";
  const loadingBtnLabel = 'Sending…';

  function clearNewsletterError() {
    newsletterField?.classList.remove('is-invalid');
    newsletterForm?.classList.remove('is-invalid');
    emailInput?.classList.remove('is-invalid');
    emailInput?.setAttribute('aria-invalid', 'false');
  }

  function showNewsletterError() {
    newsletterField?.classList.add('is-invalid');
    newsletterForm?.classList.add('is-invalid');
    emailInput?.classList.add('is-invalid');
    emailInput?.setAttribute('aria-invalid', 'true');
    emailInput?.focus();
  }

  function showNewsletterSuccess() {
    clearNewsletterError();
    newsletterForm?.classList.add('is-success');
    submitBtn?.classList.remove('is-loading');
    submitBtn?.classList.add('is-success');
    submitBtn?.setAttribute('aria-label', 'Subscribed to newsletter');
    if (btnText) btnText.textContent = successBtnLabel;

    emailInput?.setAttribute('aria-invalid', 'false');
    if (emailInput) emailInput.disabled = true;
    submitBtn?.setAttribute('disabled', 'true');

    if (successMsg) {
      successMsg.hidden = false;
      requestAnimationFrame(() => {
        successMsg.classList.add('is-visible');
      });
    }
  }

  function isValidNewsletterEmail(value: string): boolean {
    const trimmed = value.trim();
    if (!trimmed) return false;
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed);
  }

  if (newsletterForm && emailInput && submitBtn && btnText) {
    emailInput.addEventListener('input', () => {
      if (newsletterField?.classList.contains('is-invalid')) {
        clearNewsletterError();
      }
    });

    newsletterForm.addEventListener('submit', (event) => {
      event.preventDefault();

      if (newsletterForm.classList.contains('is-success')) return;

      clearNewsletterError();
      successMsg?.classList.remove('is-visible');
      if (successMsg) successMsg.hidden = true;

      const emailValue = emailInput.value.trim();
      emailInput.value = emailValue;

      if (!isValidNewsletterEmail(emailValue)) {
        showNewsletterError();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.classList.add('is-loading');
      btnText.textContent = loadingBtnLabel;

      window.setTimeout(() => {
        showNewsletterSuccess();
      }, 450);
    });
  }
</script>
