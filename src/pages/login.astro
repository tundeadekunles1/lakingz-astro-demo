---
import '../styles/index.css';
import '../styles/portal.css';
import { firm } from '../data/mock/prototype';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/lkzfavicon.png" />
    <title>Sign in — {firm.name}</title>
  </head>
  <body class="portal-body">
    <main style="min-height: 100vh; display: grid; place-items: center; padding: var(--space-md);">
      <section class="proto-card proto-card-pad" style="width: min(100%, 28rem); text-align: center;">
        <a href="/" class="proto-link" style="font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase;">← Back to website</a>

        <div style="margin: 1.5rem 0 1rem;">
          <img src="/LKZlogo.webp" alt="" width="48" height="48" style="margin: 0 auto 0.75rem; border-radius: 12px;" />
          <h1 class="proto-display proto-display-md">{firm.name}</h1>
          <p class="proto-muted" style="font-size: var(--fs-sm); margin-top: 0.35rem;">Prototype sign-in chooser</p>
        </div>

        <p class="proto-muted" style="font-size: var(--fs-sm); line-height: 1.6; margin-bottom: 1.25rem;">
          No backend in this demo — pick a portal to explore the clickable prototype for your client review.
        </p>

        <div class="login-prototype-chooser">
          <a href="/portal" class="proto-btn proto-btn--primary" style="width: 100%;">Enter client portal</a>
          <a href="/admin" class="proto-btn proto-btn--ghost" style="width: 100%;">Enter admin console</a>
        </div>

        <p class="login-prototype-note">
          Client view: dashboard, meetings, invoices, uploads.<br />
          Admin view: engagements, clients, billing, submissions.
        </p>
      </section>
    </main>
  </body>
</html>
